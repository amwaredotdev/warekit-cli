{
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "categories": { "correctness": "error", "suspicious": "warn", "perf": "warn" },
  "env": { "node": true, "es2024": true },
  "rules": { "no-console": "off", "no-await-in-loop": "off" },
  "ignorePatterns": ["dist/**", "node_modules/**"]
}
